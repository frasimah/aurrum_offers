# Скопируйте в .env и подставьте реальные значения.
# .env в git не попадает (см. .gitignore).

# Firecrawl — забирает страницы товаров и spec-sheet PDF.
# Ключ: https://firecrawl.dev → Dashboard → API Keys
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LlamaParse — разбор техлистов (PDF) с таблицами.
# Нужен только для кнопки «Распарсить» у документов.
# Ключ: https://cloud.llamaindex.ai → API Keys
LLAMA_CLOUD_API_KEY=llx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Пароль на вход в приложение (общий, без пользователей).
AURRUM_PASSWORD=123

# Ключ подписи сессий. Сгенерировать:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
AURRUM_SECRET_KEY=change-me

# Выставить в 1, если приложение за HTTPS (кука получит флаг Secure).
AURRUM_HTTPS=
