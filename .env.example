# Скопируйте в .env и подставьте реальные значения.
# .env в git не попадает (см. .gitignore).

# Firecrawl — забирает страницы товаров и spec-sheet PDF.
# Ключ: https://firecrawl.dev → Dashboard → API Keys
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google AI — основной извлекатель. Читает и текст страницы, и техлист
# страницей вместе с чертежами: у VENICEM размеры нарисованы на схеме и
# больше нигде. Без этого ключа приложение работает, но молча переходит
# на запасной путь по текстовому слою — карточка скажет об этом
# предупреждением, габариты со схем при этом теряются.
# Ключ: https://aistudio.google.com → Get API key
GOOGLE_API_KEY=

# LlamaParse — разбор техлистов (PDF) с таблицами.
# Запасной извлекатель, когда Google не ответил, и разбор техлиста
# по кнопке «Распарсить».
# Ключ: https://cloud.llamaindex.ai → API Keys
LLAMA_CLOUD_API_KEY=llx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Пароль на вход (общий, без пользователей). ОБЯЗАТЕЛЕН: без него вход
# закрыт совсем. Дефолта в коде нет намеренно — иначе на проде молча
# стоял бы пароль, известный всем, кто видел репозиторий.
AURRUM_PASSWORD=

# Ключ подписи сессий. Тоже обязателен: зная его, сессию можно подделать,
# и пароль уже не поможет. Сгенерировать:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
AURRUM_SECRET_KEY=

# Выставить в 1, если приложение за HTTPS (кука получит флаг Secure).
AURRUM_HTTPS=

# Модель извлечения LlamaExtract. По умолчанию openai-gpt-5.
# В режиме PREMIUM допустимы только openai-gpt-4-1, openai-gpt-5,
# openai-gpt-5-mini — Gemini как извлекающая модель недоступна.
LLAMA_EXTRACT_MODEL=

# Модель Gemini для разбора техлистов. По умолчанию gemini-3.7-flash.
GEMINI_MODEL=
